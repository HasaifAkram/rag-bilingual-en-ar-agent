      "parameters": {
        "jsCode": "const text = $json.chatInput;\nconst arabicRegex = /[\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF\\uFB50-\\uFDFF\\uFE70-\\uFEFF]/;\nconst isArabic = arabicRegex.test(text);\n\nreturn [{\n  json: {\n    ...$json,\n    language: isArabic ? 'ar' : 'en'\n  }\n}];"
      },
