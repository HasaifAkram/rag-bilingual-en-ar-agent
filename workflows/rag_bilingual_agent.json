    {
      "parameters": {
        "jsCode": "const text = $json.text; // field output by Extract from File (PDF or DOCX)\nconst regex = /Q(\\d+)\\s*\\n?([\\s\\S]*?)\\nA\\1\\s*\\n?([\\s\\S]*?)(?=\\n?Q\\d+\\s*\\n|$)/g;\n\nconst items = [];\nlet match;\nwhile ((match = regex.exec(text)) !== null) {\n  const question = match[2].trim();\n  const answer = match[3].trim();\n  if (question && answer) {\n    items.push({\n      json: {\n        pageContent: `Q: ${question}\\nA: ${answer}`\n      }\n    });\n  }\n}\nreturn items;"
      },
